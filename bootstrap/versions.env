# Single source of truth for every pinned image/tool version in this lab.
# All images below are multi-arch (amd64+arm64) manifests; the digest pins the
# manifest list, so `docker pull` on Apple Silicon resolves the arm64 layer.
#
# kindest/node digest is from the kind v0.31.0 release notes (default node
# image). Re-verify against the release notes for the kind binary actually
# installed if `kind create cluster` fails to pull.
KINDEST_NODE_IMAGE=kindest/node:v1.35.0@sha256:452d707d4862f52530247495d180205e029056831160e22870e37e3f6c1ac31f

ARGOCD_VERSION=v3.4.5
ARGOCD_INSTALL_MANIFEST=https://raw.githubusercontent.com/argoproj/argo-cd/v3.4.5/manifests/install.yaml

POSTGRES_IMAGE=postgres:16
ALPINE_IMAGE=alpine:3.20
CURL_IMAGE=curlimages/curl:8.10.1

GH_MIN_VERSION=2.40.0
